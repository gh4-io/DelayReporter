<Window x:Class="DelayReporter.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delay Reporter"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBox x:Name="InputBox" KeyDown="OnInputKeyDown" />

        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   Margin="0,7,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Width="88" Margin="0,0,8,0" />
            <Button x:Name="OkButton"
                    Content="OK"
                    Style="{StaticResource AccentButton}"
                    Width="88"
                    IsDefault="True"
                    Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
