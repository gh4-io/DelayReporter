<Window x:Class="DelayReporter.Views.PresetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage presets"
        Width="420" Height="380"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <DockPanel Margin="18,16,18,14">

        <TextBlock DockPanel.Dock="Top"
                   Text="Presets you have saved. The built-in ones cannot be changed."
                   Style="{StaticResource SecondaryText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RenameButton" Content="Rename…" Width="96" Margin="0,0,8,0" Click="OnRename" IsEnabled="False" />
            <Button x:Name="DeleteButton" Content="Delete" Width="88" Margin="0,0,8,0" Click="OnDelete" IsEnabled="False" />
            <Button Content="Close" Width="88" IsCancel="True" IsDefault="True" Style="{StaticResource AccentButton}" />
        </StackPanel>

        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <ListBox x:Name="PresetList"
                         Style="{StaticResource FileList}"
                         ItemContainerStyle="{StaticResource FileListItem}"
                         Margin="6"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           Text="You have not saved any presets yet."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
