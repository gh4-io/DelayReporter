<UserControl x:Class="DelayReporter.Controls.MultiSelectDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ToggleButton x:Name="FaceButton" HorizontalContentAlignment="Stretch" Cursor="Hand">
            <ToggleButton.Template>
                <!-- Drawn like the shell's text boxes, so the dropdowns sit quietly among them. -->
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="9,0,10,0" MinHeight="30" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Data="M 0,0 L 4,4 L 8,0" Margin="8,0,0,0"
                                  VerticalAlignment="Center" StrokeThickness="1.3"
                                  Stroke="{StaticResource TextSecondaryBrush}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <DockPanel>
                <!-- The same funnel the grid header shows, so the two read as one filter. -->
                <TextBlock x:Name="FilterGlyph" DockPanel.Dock="Right" Text="&#xE71C;"
                           Style="{StaticResource IconGlyph}" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="FaceText" Text="All" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </ToggleButton>

        <Popup x:Name="DropPopup" PlacementTarget="{Binding ElementName=FaceButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Focusable="False"
               IsOpen="{Binding IsChecked, ElementName=FaceButton, Mode=TwoWay}"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border x:Name="PopupPanel" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                    Padding="10,8" Margin="0,2,10,10" MaxWidth="420"
                    MinWidth="{Binding ActualWidth, ElementName=FaceButton}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    PreviewKeyDown="OnPopupKeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="-6,0,0,4">
                        <Button Style="{StaticResource LinkButton}" Content="Select all" Click="OnSelectAll"
                                Foreground="{StaticResource AccentBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Clear" Click="OnClear"
                                Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,6"
                            Background="{StaticResource BorderBrush}"/>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Open a movement sheet to choose from its values." Visibility="Collapsed"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Nothing ticked is the same as everything ticked."/>
                    <!-- Values a preset or the defaults asked for that this file does not hold. -->
                    <TextBlock x:Name="NoteText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                        <ItemsControl x:Name="ItemList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The family CheckBox shows Content as plain text, so an
                                         underscore in a label is never taken as an access key. -->
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding ToolTip}"
                                              Content="{Binding Display}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
