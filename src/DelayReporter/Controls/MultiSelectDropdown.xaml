<UserControl x:Class="DelayReporter.Controls.MultiSelectDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ToggleButton x:Name="FaceButton" HorizontalContentAlignment="Stretch">
            <ToggleButton.Template>
                <!-- Drawn like the shell's text boxes, so the dropdowns sit quietly among them. -->
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            Padding="4,3" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" Margin="6,0,2,0"
                                  VerticalAlignment="Center" StrokeThickness="1.5"
                                  Stroke="{StaticResource MutedTextBrush}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <TextBlock x:Name="FaceText" Text="All" TextTrimming="CharacterEllipsis"/>
        </ToggleButton>

        <Popup x:Name="DropPopup" PlacementTarget="{Binding ElementName=FaceButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Focusable="False"
               IsOpen="{Binding IsChecked, ElementName=FaceButton, Mode=TwoWay}"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border x:Name="PopupPanel" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    Padding="8,6" Margin="0,2,0,0" MaxWidth="420"
                    MinWidth="{Binding ActualWidth, ElementName=FaceButton}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    PreviewKeyDown="OnPopupKeyDown">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Hyperlink Click="OnSelectAll" Foreground="{StaticResource AccentBrush}">Select all</Hyperlink>
                        <Run Text="  ·  " Foreground="{StaticResource MutedTextBrush}"/>
                        <Hyperlink Click="OnClear" Foreground="{StaticResource AccentBrush}">Clear</Hyperlink>
                    </TextBlock>
                    <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,4"
                            Background="{StaticResource BorderBrushSoft}"/>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Open a movement sheet to choose from its values." Visibility="Collapsed"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Nothing ticked is the same as everything ticked."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <ItemsControl x:Name="ItemList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A TextBlock rather than plain content, so an underscore in a
                                         label is shown rather than taken as an access key. -->
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding ToolTip}">
                                        <TextBlock Text="{Binding Display}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
