<Window x:Class="DelayReporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DelayReporter.Controls"
        Title="Delay Reporter" Height="720" Width="1120"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource WindowBrush}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Window.Resources>
        <controls:CodePartsConverter x:Key="CodeParts"/>
    </Window.Resources>

    <DockPanel>

        <!-- Commands -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,8" Margin="10,10,10,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="OpenButton" Content="_Open…" Click="OnOpen"/>
                    <Button x:Name="GenerateButton" Content="_Generate report…" Click="OnGenerate" IsEnabled="False"/>
                    <Button x:Name="PreviewButton" Content="_Preview in Excel" Click="OnPreview" IsEnabled="False"
                            ToolTip="Open the report in Excel as a temporary copy, without saving it"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="_Settings" Click="OnSettings" ToolTip="Choose how the preview and the report read"/>
                    <Button Content="_Mappings" Click="OnOpenMappings" ToolTip="Open the folder holding the editable mapping CSVs"/>
                    <Button Content="_About" Click="OnAbout" Margin="0"/>
                </StackPanel>
                <TextBlock x:Name="FileText" Text="No file loaded — open a movement sheet, or drop one on this window."
                           VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="10,6" Margin="10,6,10,10">
            <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Options -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Station" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <!-- Editable, so a station absent from the loaded file can still be typed. -->
                        <ComboBox x:Name="StationBox" IsEditable="True" Text="CVG"/>
                        <TextBlock x:Name="StationHint" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                   Text="Departures from this station are reported."/>

                        <TextBlock Text="Minimum delay" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="MinimumDelayBox" Text="15" Width="56" TextChanged="OnOptionChanged"/>
                            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <RadioButton x:Name="BasisCodesRadio" GroupName="Basis" IsChecked="True"
                                     Content="sum of included delay codes" Checked="OnOptionChanged" Margin="0,6,0,0"/>
                        <RadioButton x:Name="BasisActualRadio" GroupName="Basis"
                                     Content="actual delay (ATD − STD)" Checked="OnOptionChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                   Text="0 reports every flight that has a code."/>

                        <TextBlock Text="Dates" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="DateFromPicker" Width="140" SelectedDateChanged="OnOptionChanged"/>
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0"/>
                            <DatePicker x:Name="DateToPicker" Width="140" SelectedDateChanged="OnOptionChanged"/>
                        </StackPanel>

                        <TextBlock Text="Movement types" Style="{StaticResource SectionHeader}"/>
                        <controls:MultiSelectDropdown x:Name="MovementTypeFilter" SelectionChanged="OnOptionChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                   Text="Ground runs and tows start unticked."/>

                        <TextBlock Text="Operators" Style="{StaticResource SectionHeader}"/>
                        <controls:MultiSelectDropdown x:Name="OperatorFilter" SelectionChanged="OnOptionChanged"/>

                        <TextBlock Text="Delay codes" Style="{StaticResource SectionHeader}"/>
                        <controls:MultiSelectDropdown x:Name="DelayCodeFilter" SelectionChanged="OnOptionChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                   Text="Codes found in this file. All reports every code."/>

                        <TextBlock Text="Tail numbers" Style="{StaticResource SectionHeader}"/>
                        <controls:MultiSelectDropdown x:Name="RegistrationFilter" SelectionChanged="OnOptionChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                   Text="All reports every aircraft."/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentLightBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                                   Text="Open a movement sheet to see what will be reported."/>
                    </Border>

                    <Border DockPanel.Dock="Top" x:Name="WarningPanel" Visibility="Collapsed"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <TextBlock x:Name="WarningText" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </Border>

                    <ListView x:Name="FlightList" BorderBrush="{StaticResource BorderBrushSoft}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Date" Width="82" DisplayMemberBinding="{Binding DateText}"/>
                                <GridViewColumn Header="MVT Nr" Width="72" DisplayMemberBinding="{Binding FlightNumber}"/>
                                <GridViewColumn Header="Reg" Width="72" DisplayMemberBinding="{Binding Registration}"/>
                                <GridViewColumn Header="To" Width="46" DisplayMemberBinding="{Binding To}"/>
                                <GridViewColumn Header="STD" Width="52" DisplayMemberBinding="{Binding ScheduledText}"/>
                                <GridViewColumn Header="Delay" Width="52" DisplayMemberBinding="{Binding ActualDelayText}"/>
                                <GridViewColumn Header="Coded" Width="52" DisplayMemberBinding="{Binding CodedDelayText}"/>

                                <!-- Three states: indeterminate leaves the flight to its codes, ticked
                                     forces MX, empty excludes it. "MX" beside the box shows the result,
                                     muted while it is automatic. The click is handled in code so the
                                     cycle runs automatic, force, exclude, whatever WPF's own order. -->
                                <GridViewColumn Header="MX" Width="58">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Background="Transparent"
                                                        ToolTip="{Binding MxDescription}">
                                                <CheckBox IsThreeState="True" Margin="0" VerticalAlignment="Center"
                                                          IsChecked="{Binding MxOverride, Mode=OneWay}"
                                                          Click="OnMxClick"/>
                                                <TextBlock x:Name="MxText" Text="MX" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMxDelay}" Value="False">
                                                    <Setter TargetName="MxText" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MxOverride}" Value="{x:Null}">
                                                    <Setter TargetName="MxText" Property="Foreground"
                                                            Value="{StaticResource MutedTextBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn x:Name="OperatorColumn" Header="OPR" Width="120"
                                                DisplayMemberBinding="{Binding OperatorDisplay}"/>

                                <!-- One run per code, so codes the Delay codes filter did not choose can
                                     be dimmed or hidden without touching the others. -->
                                <GridViewColumn Header="Codes" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl Focusable="False">
                                                <ItemsControl.ItemsSource>
                                                    <MultiBinding Converter="{StaticResource CodeParts}">
                                                        <Binding/>
                                                        <Binding Path="UnselectedCodes"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </ItemsControl.ItemsSource>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock x:Name="Part" Text="{Binding Text}"/>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                <Setter TargetName="Part" Property="Foreground"
                                                                        Value="{StaticResource MutedTextBrush}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
